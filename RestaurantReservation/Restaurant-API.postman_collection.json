{
  "info": {
    "name": "Restaurant Reservation API",
    "description": "Complete API collection for testing the Restaurant Reservation System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Token saved:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Owner\",\n  \"email\": \"owner@restaurant.com\",\n  \"password\": \"password123\",\n  \"role\": \"OWNER\",\n  \"restaurantId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Token saved:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@restaurant.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Restaurants",
      "item": [
        {
          "name": "Get All Restaurants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants"]
            }
          }
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Georgian Bistro\",\n  \"phone\": \"+995555123456\",\n  \"address\": \"Rustaveli Ave 1, Tbilisi\",\n  \"cuisineType\": \"Georgian\",\n  \"openingHours\": \"Mon-Sun: 10:00-23:00\",\n  \"timezone\": \"Asia/Tbilisi\",\n  \"defaultReservationMinutes\": 90,\n  \"gracePeriodMinutes\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants"]
            }
          }
        },
        {
          "name": "Get Restaurant by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/restaurants/1",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "1"]
            }
          }
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Georgian Bistro Updated\",\n  \"phone\": \"+995555123456\",\n  \"address\": \"Rustaveli Ave 1, Tbilisi\",\n  \"cuisineType\": \"Georgian Fusion\",\n  \"openingHours\": \"Mon-Sun: 10:00-23:00\",\n  \"timezone\": \"Asia/Tbilisi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/1",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Tables",
      "item": [
        {
          "name": "Create Table",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Table 1\",\n  \"capacity\": 4,\n  \"status\": \"AVAILABLE\",\n  \"positionX\": 10.0,\n  \"positionY\": 10.0,\n  \"restaurantId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tables",
              "host": ["{{baseUrl}}"],
              "path": ["tables"]
            }
          }
        },
        {
          "name": "Get Tables by Restaurant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tables?restaurantId=1",
              "host": ["{{baseUrl}}"],
              "path": ["tables"],
              "query": [
                {
                  "key": "restaurantId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 1,\n  \"tableId\": 1,\n  \"guestName\": \"Alice Smith\",\n  \"guestPhone\": \"+995555111222\",\n  \"guestEmail\": \"alice@example.com\",\n  \"startTime\": \"2026-05-20T19:00:00\",\n  \"partySize\": 4,\n  \"notes\": \"Window seat preferred\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"]
            }
          }
        },
        {
          "name": "Get Daily Reservations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/daily?restaurantId=1&date=2026-05-20",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "daily"],
              "query": [
                {
                  "key": "restaurantId",
                  "value": "1"
                },
                {
                  "key": "date",
                  "value": "2026-05-20"
                }
              ]
            }
          }
        },
        {
          "name": "Check Available Tables",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/available-tables?restaurantId=1&startTime=2026-05-20T19:00:00&endTime=2026-05-20T20:30:00",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "available-tables"],
              "query": [
                {
                  "key": "restaurantId",
                  "value": "1"
                },
                {
                  "key": "startTime",
                  "value": "2026-05-20T19:00:00"
                },
                {
                  "key": "endTime",
                  "value": "2026-05-20T20:30:00"
                }
              ]
            }
          }
        },
        {
          "name": "Update Reservation Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservations/1/status?status=COMPLETED",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "1", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "COMPLETED"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard?restaurantId=1",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"],
              "query": [
                {
                  "key": "restaurantId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Analytics",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics?restaurantId=1&start=2026-05-01&end=2026-05-31",
              "host": ["{{baseUrl}}"],
              "path": ["analytics"],
              "query": [
                {
                  "key": "restaurantId",
                  "value": "1"
                },
                {
                  "key": "start",
                  "value": "2026-05-01"
                },
                {
                  "key": "end",
                  "value": "2026-05-31"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. Users",
      "item": [
