              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Manager\",\n  \"email\": \"manager@restaurant.com\",\n  \"password\": \"password123\",\n  \"role\": \"MANAGER\",\n  \"restaurantId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
